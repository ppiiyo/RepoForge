{
  "name": "repoforge",
  "version": "0.2.0",
  "description": "Production-grade repository hardening engine. Turns any repo into a production-ready project with tests, CI, security, docs and verifiable quality.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "repoforge": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppiiyo/RepoForge.git"
  },
  "bugs": {
    "url": "https://github.com/ppiiyo/RepoForge/issues"
  },
  "homepage": "https://github.com/ppiiyo/RepoForge#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "repository",
    "hardening",
    "ci",
    "testing",
    "security",
    "documentation",
    "production-ready",
    "code-quality",
    "github-actions",
    "docker"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
