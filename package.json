{
  "name": "repoforge",
  "version": "0.3.1",
  "description": "Repository hardening engine: analyze a repo and safely add CI, tests, Docker, docs, and a security baseline.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "repoforge": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppiiyo/RepoForge.git"
  },
  "bugs": {
    "url": "https://github.com/ppiiyo/RepoForge/issues"
  },
  "homepage": "https://github.com/ppiiyo/RepoForge#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "node --experimental-strip-types --experimental-loader ./scripts/ts-resolve.mjs scripts/smoke-test.mjs",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "repository",
    "hardening",
    "ci",
    "testing",
    "security",
    "docker",
    "github-actions",
    "devops",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
