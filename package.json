{
  "name": "repoforge",
  "version": "0.1.0",
  "description": "Production-grade repository hardening engine. Turns any repo into a production-ready project with tests, CI, security, docs and verifiable quality.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "repoforge": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "repository",
    "hardening",
    "ci",
    "testing",
    "security",
    "documentation",
    "production-ready",
    "code-quality"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
